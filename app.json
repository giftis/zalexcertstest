{
  "expo": {
    "name": "Zalex Certificates",
    "slug": "zalex-certificates",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zalex.certificates"
    },
    "android": {
      "package": "com.zalex.certificates",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
